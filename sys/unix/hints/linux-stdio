#-PRE
# Hints file for a stdio build
# This hints file provides the base for a minimal stdio build for Linux

PREFIX = $(wildcard ~)/.local/bin
HACKDIR = $(wildcard ~)/.local/lib/$(GAME)dir
SHELLDIR = $(PREFIX)
INSTDIR = $(HACKDIR)
VARDIR = $(HACKDIR)

POSTINSTALL+= cp -n sys/unix/sysconf $(INSTDIR)/sysconf; \
	$(CHOWN) $(GAMEUID) $(INSTDIR)/sysconf; \
	$(CHGRP) $(GAMEGRP) $(INSTDIR)/sysconf; \
	chmod $(VARFILEPERM) $(INSTDIR)/sysconf;

CFLAGS += -g -I../include
CFLAGS += -DSTDIO_GRAPHICS -DWINCHAIN
#CFLAGS += -DNOTTYGRAPHICS
CFLAGS += -DHACKDIR=\"$(HACKDIR)\"

SYSCFLAGS = -DLUA_USE_POSIX

LINK = $(CC)
LFLAGS += -rdynamic

WINSRC += $(WINTTYSRC)
WINOBJ += $(WINTTYOBJ)
WINLIB += $(WINTTYLIB)
WINTTYLIB = -lncurses -ltinfo

HINTSRC += $(CHAINSRC)
HINTOBJ += $(CHAINOBJ)

WINSRC += $(WINSTDIOSRC) $(HINTSRC)
WINOBJ += $(WINSTDIOOBJ)

CHOWN=true
CHGRP=true

VARDIRPERM = 0755
VARFILEPERM = 0600
GAMEPERM = 0755
