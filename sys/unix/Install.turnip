###############################################################################
# howto build & install single user NetHack on turnip

# setup
sudo apt update
sudo apt install build-essential
sudo apt install libncurses-dev

cd ~/projects/nethack
make spotless
cd sys/unix
sh setup.sh hints/avocado
cd ../..
make fetch-lua
make all
make install
cd doc
sudo make manpages

###############################################################################
# howto build & install chrooted NetHack on turnip
# also see https://github.com/mlehotay/dgamelaunch/blob/master/examples/floatingeye.txt

#sudo rm -rf /opt/dgl
cd ~/projects/nethack
make spotless
cd sys/unix
sh setup.sh hints/floatingeye
cd ../..
make all
sudo make install
cd /opt/dgl
#sudo mkdir dgldir dgldir/userdata dgldir/userdata/root
#sudo mkdir dgldir/userdata/root/nh370 dgldir/userdata/root/nh370/dumplog
sudo chown -R games:games nh370 dgldir
sudo ~/projects/nethack/sys/unix/mkchroot.sh nh370/nethack
sudo chroot ./ nh370/nethack
